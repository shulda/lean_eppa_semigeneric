import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Data.Finset.Basic

/-!
# A directed union of finite-stage permutation groups: finite restriction density

The positive DLF argument constructs a countable chain of finite
groups K₀≤K₁≤... of ACTUAL raw automorphisms of a limit M.
The group generated by the chain is exactly their union, because
the chain is ascending.

Topological density in the pointwise-convergence topology of
Aut(M) is equivalent to matching every automorphism on every
finite set of vertices. This file isolates the latter property
as a precise algebraic predicate, without assuming topology or
using any Fraïssé-limit existence theorem.

If the finite-stage groups can approximate every target
automorphism on each finite set, their single union subgroup
has the same finite-restriction approximation property.
This is the DENSITY half of the abstract limit bridge.
The separately certified ascending-finite-subgroups lemma is
its LOCAL FINITENESS half.

We do not yet assert the topological equivalence of the
approximation predicate to actual density, nor do we
construct the coherent stage-by-stage embeddings.
-/

namespace SemigenericEPPA

universe u
variable {V : Type u}

/-- A subgroup K≤Aut(V) matches all elements of a target
permutation group A on every finite set of points.
For A the actual raw automorphism subgroup, this is the
finite-restriction formulation of pointwise-convergence density. -/
def DenseByFiniteRestrictions
    (A K : Subgroup (Equiv.Perm V)) : Prop :=
  K ≤ A ∧
    ∀ (a : A) (F : Finset V),
      ∃ k : K, ∀ (x : V), x ∈ F → k.val x = a.val x

/-- The ascending union of a chain of permutation subgroups,
as an actual subgroup of the SAME full permutation group. -/
def ascendingUnionPermSubgroup
    (K : ℕ → Subgroup (Equiv.Perm V))
    (hmono : Monotone K) : Subgroup (Equiv.Perm V) where
  carrier := {f | ∃ n : ℕ, f ∈ K n}
  one_mem' := ⟨0, (K 0).one_mem⟩
  mul_mem' := by
    rintro f g ⟨n, hf⟩ ⟨m, hg⟩
    refine ⟨max n m, (K (max n m)).mul_mem ?_ ?_⟩
    · exact hmono (le_max_left n m) hf
    · exact hmono (le_max_right n m) hg
  inv_mem' := by
    rintro f ⟨n, hf⟩
    exact ⟨n, (K n).inv_mem hf⟩

@[simp] theorem mem_ascendingUnionPermSubgroup
    (K : ℕ → Subgroup (Equiv.Perm V))
    (hmono : Monotone K) (g : Equiv.Perm V) :
    g ∈ ascendingUnionPermSubgroup K hmono ↔
      ∃ n : ℕ, g ∈ K n := Iff.rfl

/-- If every finite-stage group lies inside A, so does the
ascending union. -/
theorem ascendingUnionPermSubgroup_le
    (A : Subgroup (Equiv.Perm V))
    (K : ℕ → Subgroup (Equiv.Perm V))
    (hmono : Monotone K)
    (hKA : ∀ n, K n ≤ A) :
    ascendingUnionPermSubgroup K hmono ≤ A := by
  rintro g ⟨n, hg⟩
  exact hKA n hg

/-- Finite-restriction approximation is retained by a SINGLE
subgroup obtained as the ascending union of the chosen stages.
No unrelated choices of extension groups occur. -/
theorem denseByFiniteRestrictions_ascendingUnion
    (A : Subgroup (Equiv.Perm V))
    (K : ℕ → Subgroup (Equiv.Perm V))
    (hmono : Monotone K)
    (hKA : ∀ n, K n ≤ A)
    (hApprox : ∀ (a : A) (F : Finset V),
      ∃ n : ℕ, ∃ k : K n,
        ∀ (x : V), x ∈ F → k.val x = a.val x) :
    DenseByFiniteRestrictions A
      (ascendingUnionPermSubgroup K hmono) := by
  constructor
  · exact ascendingUnionPermSubgroup_le A K hmono hKA
  · intro a F
    obtain ⟨n, k, hk⟩ := hApprox a F
    refine ⟨⟨k.val, ⟨n, k.property⟩⟩, ?_⟩
    exact hk

end SemigenericEPPA
