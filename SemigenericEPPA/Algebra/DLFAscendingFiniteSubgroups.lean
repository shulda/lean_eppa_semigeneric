import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Data.Finset.Basic
import Mathlib.Data.Fintype.EquivFin

/-!
# An ascending union of finite subgroups is locally finite

The countable-limit bridge for DLF ultimately constructs a subgroup
as the increasing union of finite groups of actual automorphisms.
Its **local finiteness** is elementary and should be certified
independently of Fraïssé limits, topology and the two-sorted
semigeneric geometry.

For any group Q with a monotone chain H_0 ≤ H_1 ≤ ... of finite
subgroups covering Q, each finite set of elements is contained
in a single H_n; therefore the subgroup generated by any finite
set is itself finite.

This is one algebraic component of the dense locally finite (DLF)
subgroup argument, not a density theorem and not a construction
of the requisite ascending chain of automorphism groups.
-/

namespace SemigenericEPPA

universe u
variable {Q : Type u} [Group Q]

/-- A group is locally finite in the algebraic sense if the
subgroup generated by every finite set of elements is finite. -/
def EveryFinitelyGeneratedSubgroupFinite (Q : Type u) [Group Q] : Prop :=
  ∀ s : Finset Q, Finite (Subgroup.closure (s : Set Q))

/-- Every finite subset of an ascending group tower lies in a
single stage. This uses only directedness of the natural numbers
and does not require any choice of generators for Q. -/
theorem finiteSubset_in_ascendingSubgroup
    (H : ℕ → Subgroup Q)
    (hmono : Monotone H)
    (hcover : ∀ q : Q, ∃ n : ℕ, q ∈ H n)
    (s : Finset Q) :
    ∃ n : ℕ, ∀ q : Q, q ∈ s → q ∈ H n := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      refine ⟨0, ?_⟩
      intro q hq
      simp at hq
  | @insert a s has ih =>
      obtain ⟨n, han⟩ := hcover a
      obtain ⟨m, hm⟩ := ih
      refine ⟨max n m, ?_⟩
      intro q hq
      rcases Finset.mem_insert.mp hq with hqa | hqs
      · subst q
        exact (hmono (le_max_left n m)) han
      · exact (hmono (le_max_right n m)) (hm q hqs)

/-- A covering ascending union of finite subgroups is locally
finite. In particular every finitely generated subgroup of an eventual
ascending union of finite automorphism groups is finite. -/
theorem locallyFinite_of_ascendingFiniteSubgroups
    (H : ℕ → Subgroup Q)
    (hmono : Monotone H)
    (hfinite : ∀ n, Finite (H n))
    (hcover : ∀ q : Q, ∃ n : ℕ, q ∈ H n) :
    EveryFinitelyGeneratedSubgroupFinite Q := by
  intro s
  obtain ⟨n, hn⟩ :=
    finiteSubset_in_ascendingSubgroup H hmono hcover s
  have hsubset : (s : Set Q) ⊆ (H n : Set Q) := by
    intro q hq
    exact hn q hq
  have hclosure : Subgroup.closure (s : Set Q) ≤ H n :=
    Subgroup.closure_le.mpr hsubset
  letI : Finite (H n) := hfinite n
  exact Finite.of_injective
    (fun x : Subgroup.closure (s : Set Q) =>
      (⟨x.val, hclosure x.property⟩ : H n))
    (by
      intro x y h
      apply Subtype.ext
      exact congrArg Subtype.val h)

end SemigenericEPPA
