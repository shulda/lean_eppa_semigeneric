import SemigenericEPPA.Algebra.RelativeDLFGraphFreeAction

/-!
# Relative DLF cover graph: no loops and explicit finite-path connectivity

The audited relative involution-killing graph has three Q-invariant
vertex layers Q/H, Q×{1}, Q×{2} and two explicit edge layers.
Its connectivity is elementary but must be certified before
constructing the F₂-chain extension:
  every first-layer vertex connects to a chosen free second-layer
  vertex; every second-layer vertex connects to the hub (false,1);
  every coset vertex connects to its representative first-layer
  vertex.

We prove an explicit path to a fixed hub using ≤3 edges, and
connect any two vertices via that hub. This avoids relying on
an unverified equivalence between vertex-level regularity and
edge-level noninversion; the latter is already handled separately
by the graph-action lemma.

No chain boundary, parity obstruction or relative group cover is
asserted here. This is a strict finite combinatorial graph gate.
-/

namespace SemigenericEPPA

universe u
variable {Q : Type u} [Group Q]

namespace RelativeDLF

/-- Undirected adjacency generated by the literal two edge layers. -/
def EdgeAdjacent (H : Subgroup Q)
    (x y : CoverVertex H) : Prop :=
  ∃ e : CoverEdge H,
    (edgeSource H e = x ∧ edgeTarget H e = y) ∨
    (edgeSource H e = y ∧ edgeTarget H e = x)

/-- Symmetry does not require any choice of edge orientation. -/
theorem edgeAdjacent_symm (H : Subgroup Q)
    {x y : CoverVertex H} (h : EdgeAdjacent H x y) :
    EdgeAdjacent H y x := by
  obtain ⟨e, h | h⟩ := h
  · exact ⟨e, Or.inr ⟨h.1, h.2⟩⟩
  · exact ⟨e, Or.inl ⟨h.1, h.2⟩⟩

/-- Finite edge paths represented by the equivalence closure of
literal undirected adjacency. -/
inductive EdgeConnected (H : Subgroup Q) :
    CoverVertex H → CoverVertex H → Prop
  | refl (x : CoverVertex H) : EdgeConnected H x x
  | step {x y : CoverVertex H} :
      EdgeAdjacent H x y → EdgeConnected H x y
  | trans {x y z : CoverVertex H} :
      EdgeConnected H x y → EdgeConnected H y z →
        EdgeConnected H x z
  | symm {x y : CoverVertex H} :
      EdgeConnected H x y → EdgeConnected H y x

/-- An explicit free first-layer hub independent of H. -/
def graphHub (H : Subgroup Q) : CoverVertex H :=
  .inr (false, 1)

/-- Every actual vertex admits a path to the same fixed hub,
with no finiteness assumption on Q needed for this fact. -/
theorem edgeConnected_toHub
    (H : Subgroup Q) (x : CoverVertex H) :
    EdgeConnected H x (graphHub H) := by
  cases x with
  | inl coset =>
      induction coset using Quotient.inductionOn with
      | _ q =>
          have h0 : EdgeConnected H
              (.inl (Quotient.mk (leftCosetSetoid H) q))
              (.inr (false, q)) :=
            EdgeConnected.step ⟨.inl q, Or.inl ⟨rfl, rfl⟩⟩
          have h1 : EdgeConnected H
              (.inr (false, q))
              (.inr (true, 1)) :=
            EdgeConnected.step ⟨.inr (q, 1), Or.inl ⟨rfl, rfl⟩⟩
          have h2 : EdgeConnected H
              (.inr (true, 1)) (graphHub H) :=
            EdgeConnected.step ⟨.inr (1, 1), Or.inr ⟨rfl, rfl⟩⟩
          exact h0.trans (h1.trans h2)
  | inr pair =>
      rcases pair with ⟨layer, q⟩
      cases layer with
      | false =>
          have h1 : EdgeConnected H
              (.inr (false, q))
              (.inr (true, 1)) :=
            EdgeConnected.step ⟨.inr (q, 1), Or.inl ⟨rfl, rfl⟩⟩
          have h2 : EdgeConnected H
              (.inr (true, 1)) (graphHub H) :=
            EdgeConnected.step ⟨.inr (1, 1), Or.inr ⟨rfl, rfl⟩⟩
          exact h1.trans h2
      | true =>
          exact EdgeConnected.step
            ⟨.inr (1, q), Or.inr ⟨rfl, rfl⟩⟩

/-- The undirected graph is connected: two vertices reach the
same hub via at most three edges apiece. -/
theorem allVertices_edgeConnected
    (H : Subgroup Q) (x y : CoverVertex H) :
    EdgeConnected H x y :=
  (edgeConnected_toHub H x).trans
    (edgeConnected_toHub H y).symm

/-- The graph is loop-free because endpoints of every edge
belong to two different fixed Q-invariant layers. -/
theorem no_loop (H : Subgroup Q) (e : CoverEdge H) :
    edgeSource H e ≠ edgeTarget H e := by
  cases e with
  | inl q =>
      intro h
      cases h
  | inr qr =>
      rcases qr with ⟨q,r⟩
      intro h
      simp [edgeSource, edgeTarget] at h

end RelativeDLF

end SemigenericEPPA
